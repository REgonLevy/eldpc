  "key": "E",
  "gpu": "NVIDIA GeForce RTX 5080",
  "compute_capability": "12.0",
  "nvidia_driver": "595.91.07",
  "cpu": "AMD Ryzen 9 7950X3D 16-Core Processor",
  "cuda_toolkit": "13.3",
  "stim": "1.16.0",
  "grade": "accuracy only"
 },
 "construction_rule": "HERALDED_ERASE on t qubits writes t measurement records, so every later DETECTOR or OBSERVABLE_INCLUDE target rec[-k] with k > t is rewritten to rec[-(k+t)]; targets with k <= t stay. The uncorrected insertion copies those targets unchanged, so some final detectors read herald records.",
 "construction_check_method": {
  "dem_comparison": "exact sequence of (probability, detector ids, observable ids) of dem.flattened(), herald detectors removed and the remaining ids renumbered, against the clean circuit flattened as the insertion does",
  "rate_test": "Bonferroni-union Hoeffding bound: pass iff max_i |rate_i - rate_i'| <= sqrt(2 ln(4 m / 0.05) / shots), m = non-herald detectors",
  "shots_per_circuit": 200000
 },
